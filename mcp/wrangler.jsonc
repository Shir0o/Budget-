{
  // The cloud MCP server (ADR 0004). Setup: mcp/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budget-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Builds the Dart budget logic into src/budget.dart.js before each deploy.
  "build": { "command": "npm run build:dart" },
  "vars": {
    // The Worker's address comes from each request. To pin it, for example
    // to a custom domain, add "PUBLIC_URL": "https://<your address>" here.
    // read-only or read-write.
    "MCP_MODE": "read-write",
    // In read-write mode, which write tools to offer.
    "MCP_WRITE_TOOLS": "suggest_review,retag_line,split_line,update_transaction,revert_change,mark_imported_reviewed"
  },
  // Once a day at 15:00 UTC: read new order emails (only once GMAIL_REFRESH_TOKEN is set).
  "triggers": { "crons": ["0 15 * * *"] },
  "kv_namespaces": [
    // No id: `wrangler deploy` makes the store on the first deploy and keeps
    // the Worker linked to it after that, so no account id lives in git.
    { "binding": "OAUTH_KV" }
  ],
  "observability": { "enabled": true }
}
